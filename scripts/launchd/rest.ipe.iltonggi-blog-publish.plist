<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: replace __HOME__ (home dir). Live copy: ~/Library/LaunchAgents/rest.ipe.iltonggi-blog-publish.plist
     Times are the Mac's local time - the Mac mini runs on KST; the wrapper also checks KST itself. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>rest.ipe.iltonggi-blog-publish</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/.ipe/bin/iltonggi_blog_publish.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/.ipe/logs/iltonggi-blog-publish.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.ipe/logs/iltonggi-blog-publish.log</string>
</dict>
</plist>
